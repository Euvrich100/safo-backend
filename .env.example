# ==============================
# SafO Backend — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas .env a GitHub
# ==============================

# Servidor
PORT=3000
# En Render pon NODE_ENV=production: activa la validación estricta de esta lista, oculta el código SMS
# de los logs y deja pasar solo los orígenes de CORS_ORIGINS.
NODE_ENV=development

# Orígenes (dominios) desde los que se usa la web, separados por coma. El panel de Render ya está incluido.
# Ejemplo: https://safo.pe,https://www.safo.pe
CORS_ORIGINS=

# Documentos de conductores en Supabase Storage (OBLIGATORIO en producción).
# Supabase → Project Settings → API: la URL del proyecto y la clave «service_role» (secreta: nunca en la web ni en GitHub).
# El bucket privado «documentos» se crea solo al arrancar. Sin estas dos variables se usa la carpeta local uploads/ (solo desarrollo).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documentos

# Base de datos PostgreSQL
DATABASE_URL=postgresql://taxiplus_user:TuPasswordSegura123!@localhost:5432/taxiplus

# JWT - clave secreta para tokens de sesión
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# Twilio - envío de SMS con código OTP (opcional: sin esto, en producción el ingreso por SMS queda desactivado
# y se entra con contraseña). El número va con + y código de país.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Subida de archivos (documentos de conductores)
UPLOAD_MAX_SIZE_MB=5

# Login con Google (panel admin) — crea credenciales OAuth en
# https://console.cloud.google.com/apis/credentials
# Tipo: "ID de cliente de OAuth" → Aplicación web
# Orígenes autorizados: http://localhost:3001 y tu dominio del panel admin
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Login con Apple (web). Requiere cuenta Apple Developer: crea un "Services ID"
# https://developer.apple.com/account/resources/identifiers  (Sign in with Apple)
# APPLE_CLIENT_ID = el identificador del Services ID (ej. com.safo.web)
APPLE_CLIENT_ID=

# Login con Facebook — crea una app en https://developers.facebook.com/apps
# (producto "Inicio de sesión con Facebook"). Ambos valores van SOLO en el backend.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
