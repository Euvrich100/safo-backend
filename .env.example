# ==============================
# SafO Backend — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas .env a GitHub
# ==============================

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL=postgresql://taxiplus_user:TuPasswordSegura123!@localhost:5432/taxiplus

# JWT - clave secreta para tokens de sesión
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# Twilio - envío de SMS con código OTP
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Subida de archivos (documentos de conductores)
UPLOAD_MAX_SIZE_MB=5
